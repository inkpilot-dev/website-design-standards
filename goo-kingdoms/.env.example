# Copy this file to .env and fill in your key to let Claude play.
# Without a key, the built-in local bot plays instead (it is not Claude).
ANTHROPIC_API_KEY=

# Optional: which model the blobs use (claude-haiku-5-5, claude-sonnet-5-5 or claude-opus-5-5).
# CLAUDE_MODEL=claude-haiku-5-5

# Optional: pause a match once its estimated API spend reaches this many US dollars (0 = no limit).
# BUDGET_USD=5

# Optional: port for the local server.
# PORT=3000
